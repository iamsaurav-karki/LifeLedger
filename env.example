# ============================================
# Database Configuration
# ============================================
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=yourusername
DB_PASSWORD=yourpassword
DB_DATABASE=lifeledger_db

# ============================================
# Redis Configuration
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379

# ============================================
# JWT Configuration (CRITICAL: Change in production!)
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-12345
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production-67890
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# Application Configuration
# ============================================
PORT=5001
NODE_ENV=production
FRONTEND_URL=http://localhost:5000

# ============================================
# Rate Limiting
# ============================================
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ============================================
# Admin User Configuration
# ============================================
# The admin user will be automatically created/updated on backend startup
# If admin user already exists, password will be updated to match ADMIN_PASSWORD
ADMIN_EMAIL=admin@lifeledger.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=Admin User

# ============================================
# Docker Configuration (Optional)
# ============================================
# Container names (optional, defaults provided)
# POSTGRES_CONTAINER_NAME=lifeledger-postgres
# REDIS_CONTAINER_NAME=lifeledger-redis
# BACKEND_CONTAINER_NAME=lifeledger-backend
# FRONTEND_CONTAINER_NAME=lifeledger-frontend

# Docker image names (required for production)
# Build images first: docker build -t lifeledger-backend:latest ./backend
#                    docker build -t lifeledger-frontend:latest ./frontend
BACKEND_IMAGE=lifeledger-backend:latest
FRONTEND_IMAGE=lifeledger-frontend:latest

# Port mappings (optional, defaults provided)
# BACKEND_PORT=5001
# FRONTEND_PORT=5000
